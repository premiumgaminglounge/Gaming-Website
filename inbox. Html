<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#100c22">
<title>Orion Star Gaming</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0b0818;
    color: white;
}

header {
    background: linear-gradient(135deg, #201044, #52145e, #17102e);
    text-align: center;
    padding: 30px 15px;
    border-bottom: 2px solid #f8c95c;
}

header h1 {
    color: #ffd66b;
    font-size: clamp(25px, 5vw, 42px);
    font-weight: 900;
    text-shadow: 0 0 15px #ffb52e;
}

header p {
    margin-top: 10px;
    color: #eee5ff;
    font-size: 14px;
}

.container {
    max-width: 1200px;
    margin: auto;
    padding: 22px 15px 35px;
}

.search-box {
    width: 100%;
    padding: 15px;
    border-radius: 12px;
    border: 1px solid #7254a8;
    background: #19132b;
    color: white;
    font-size: 16px;
    margin-bottom: 22px;
    outline: none;
}

.search-box:focus {
    border-color: #ffd66b;
}

.section-title {
    color: #ffd66b;
    font-size: 23px;
    margin-bottom: 18px;
}

.games-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.game-card {
    background: linear-gradient(145deg, #24163e, #151020);
    border: 1px solid #493365;
    border-radius: 16px;
    padding: 17px 12px;
    text-align: center;
    box-shadow: 0 5px 18px #0005;
    transition: transform 0.2s, border-color 0.2s;
}

.game-card:hover {
    transform: translateY(-4px);
    border-color: #ffd66b;
}

.logo-box {
    width: 90px;
    height: 90px;
    margin: 0 auto 13px;
    border-radius: 20px;
    background: linear-gradient(135deg, #fff0b5, #ffba45, #b64bba);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    border: 2px solid #ffffff35;
}

.game-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 5px;
    background: #ffffff;
}

.logo-fallback {
    color: #29143d;
    font-size: 24px;
    font-weight: 900;
}

.game-name {
    min-height: 38px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 15px;
    font-weight: 800;
    overflow-wrap: anywhere;
}

.play-button {
    display: block;
    width: 100%;
    margin-top: 12px;
    padding: 12px 6px;
    border-radius: 30px;
    background: linear-gradient(90deg, #ffb52e, #ffe58c);
    color: #20102f;
    text-decoration: none;
    font-weight: 900;
    font-size: 12px;
    letter-spacing: 0.6px;
}

.play-button:hover {
    filter: brightness(1.12);
}

.no-results {
    grid-column: 1 / -1;
    text-align: center;
    padding: 30px;
    color: #c9bddf;
}

footer {
    margin-top: 20px;
    padding: 25px 15px;
    text-align: center;
    background: #120d20;
    border-top: 1px solid #45315d;
    color: #c9bddf;
    font-size: 13px;
    line-height: 1.8;
}

@media (min-width: 600px) {
    .games-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (min-width: 900px) {
    .games-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
}

@media (min-width: 1150px) {
    .games-grid {
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }
}
</style>
</head>

<body>

