<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Orion Star Gaming</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #080d1b;
  --panel: #111b30;
  --gold: #ffbd39;
  --text: #ffffff;
  --muted: #b8c3d8;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: Arial, sans-serif;
  line-height: 1.6;
}

header {
  min-height: 75px;
  padding: 15px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  background: #10182a;
  border-bottom: 1px solid #283653;
  position: sticky;
  top: 0;
  z-index: 100;
}

.brand {
  color: var(--gold);
  font-size: 20px;
  font-weight: 900;
}

.brand span {
  display: block;
  color: white;
  font-size: 10px;
  letter-spacing: 3px;
}

.menu-button {
  border: 1px solid #35435e;
  background: #17233b;
  color: white;
  padding: 9px 13px;
  font-size: 20px;
  border-radius: 8px;
  cursor: pointer;
}

nav {
  display: none;
  position: absolute;
  right: 5%;
  top: 70px;
  width: 210px;
  background: #131f36;
  border: 1px solid #34415c;
  border-radius: 12px;
  padding: 10px;
}

nav.open {
  display: grid;
}

nav a {
  padding: 10px;
  text-decoration: none;
  color: white;
  border-radius: 6px;
}

nav a:hover {
  background: #263550;
  color: var(--gold);
}

.hero {
  padding: 75px 20px;
  text-align: center;
  background:
    radial-gradient(ellipse at top, #233967 0%, #0b1224 55%, #080d1b 100%);
}

.badge {
  display: inline-block;
  padding: 7px 15px;
  border: 1px solid #66532d;
  border-radius: 30px;
  color: var(--gold);
  background: #292314;
  font-size: 12px;
  letter-spacing: 1px;
}

.hero h1 {
  font-size: clamp(32px, 7vw, 55px);
  line-height: 1.2;
  margin: 22px auto;
  max-width: 800px;
}

.hero h1 span {
  color: var(--gold);
}

.hero p {
  color: var(--muted);
  max-width: 600px;
  margin: 0 auto 25px;
}

.button {
  display: inline-block;
  background: var(--gold);
  color: #17120a;
  text-decoration: none;
  font-weight: bold;
  padding: 12px 22px;
  border-radius: 9px;
  border: 0;
  cursor: pointer;
}

.button.secondary {
  background: #202e49;
  color: white;
  border: 1px solid #3a4b6b;
}

.section {
  padding: 55px 5%;
  max-width: 1200px;
  margin: auto;
}

.section-heading {
  text-align: center;
  margin-bottom: 25px;
}

.section-heading h2 {
  font-size: 28px;
}

.section-heading p {
  color: var(--muted);
  margin-top: 5px;
}

.search {
  display: block;
  width: 100%;
  max-width: 450px;
  margin: 0 auto 28px;
  padding: 13px 15px;
  background: #111b30;
  border: 1px solid #35435e;
  border-radius: 9px;
  color: white;
  font-size: 16px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.card {
  background: var(--panel);
  border: 1px solid #263650;
  border-radius: 15px;
  padding: 23px;
  transition: transform .2s, border-color .2s;
}

.card:hover {
  transform: translateY(-4px);
  border-color: var(--gold);
}

.game-icon {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: #263653;
  font-size: 35px;
  margin-bottom: 17px;
}

.card h3 {
  color: var(--gold);
  margin-bottom: 8px;
}

.card p {
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 18px;
}

.card .button {
  padding: 9px 13px;
  font-size: 13px;
}

.info-box {
  background: linear-gradient(135deg, #172947, #11182a);
  border: 1px solid #354767;
  padding: 28px;
  border-radius: 15px;
  text-align: center;
}

.info-box p {
  color: var(--muted);
  margin: 10px auto 18px;
  max-width: 650px;
}

footer {
  border-top: 1px solid #263650;
  background: #0d1424;
  text-align: center;
  padding: 28px 15px;
  color: #a8b3c8;
  font-size: 13px;
}

#chat-button {
  position: fixed;
  right: 18px;
  bottom: 18px;
  z-index: 200;
  background: #20d69a;
  color: #061a13;
  border: 0;
  border-radius: 30px;
  padding: 14px 19px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 4px 18px #0008;
}

#chat-box {
  display: none;
  position: fixed;
  right: 15px;
  bottom: 78px;
  width: min(340px, calc(100vw - 30px));
  height: 390px;
  max-height: 65vh;
  z-index: 200;
  background: #111d33;
  border: 1px solid #354969;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 8px 30px #0009;
}

.chat-header {
  background: #1b2c4b;
  padding: 13px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: bold;
}

#chat-close {
  background: none;
  border: none;
  color: white;
  font-size: 22px;
  cursor: pointer;
}

#chat-messages {
  height: calc(100% - 120px);
  padding: 12px;
  overflow-y: auto;
}

.message {
  background: #243653;
  padding: 10px;
  border-radius: 9px;
  margin-bottom: 9px;
  overflow-wrap: anywhere;
  font-size: 14px;
}

.chat-form {
  display: flex;
  gap: 6px;
  padding: 9px;
}

#chat-input {
  min-width: 0;
  flex: 1;
  background: #091326;
  border: 1px solid #354969;
  border-radius: 7px;
  padding: 9px;
  color: white;
}

.chat-form button {
  background: #20d69a;
  color: #071b14;
  border: 0;
  padding: 9px;
  border-radius: 7px;
  cursor: pointer;
}

@media (max-width: 480px) {
  header {
    padding: 13px 4%;
  }

  .brand {
    font-size: 17px;
  }

  .hero {
    padding: 60px 18px;
  }

  .section {
    padding: 42px 18px;
  }

  .cards {
    grid-template-columns: 1fr;
  }
}
</style>
</head>

<body>

<header>
  <div class="brand">
    ⭐ ORION STAR GAMING
    <span>GAMING INFORMATION CENTER</span>
  </div>

  <button class="menu-button" id="menu-button"
    aria-label="Open menu" aria-expanded="false">☰</button>

  <nav id="navigation">
    <a href="#home">Home</a>
    <a href="#games">Featured Games</a>
    <a href="#popular">Popular Categories</a>
    <a href="#about">About Us</a>
    <a href="#support">Support</a>
  </nav>
</header>

<main>
  <section class="hero" id="home">
    <div class="badge">★ WELCOME TO ORION STAR ★</div>

    <h1>
      Explore the World of<br>
      <span>Gaming Experiences</span>
    </h1>

    <p>
      Discover gaming categories, learn about game features,
      and explore useful gaming information in one place.
    </p>

    <a class="button" href="#games">Explore Games →</a>
  </section>

  <section class="section" id="games">
    <div class="section-heading">
      <h2>🎮 Featured Games</h2>
      <p>Explore our gaming information cards.</p>
    </div>

    <input
      class="search"
      id="game-search"
      type="search"
      placeholder="Search games or categories..."
      aria-label="Search games">

    <div class="cards" id="game-cards">

      <article class="card" data-search="action arcade">
        <div class="game-icon">🎯</div>
        <h3>Action Games</h3>
        <p>Explore action gameplay, features and arcade-style experiences.</p>
        <a class="button secondary" href="#about">Learn More</a>
      </article>

      <article class="card" data-search="racing cars driving">
        <div class="game-icon">🏎️</div>
        <h3>Racing Games</h3>
        <p>Discover driving games, racing tracks and vehicle features.</p>
        <a class="button secondary" href="#about">Learn More</a>
      </article>

      <article class="card" data-search="adventure missions">
        <div class="game-icon">🗺️</div>
        <h3>Adventure Games</h3>
        <p>Learn about virtual worlds, missions and exploration.</p>
        <a class="button secondary" href="#about">Learn More</a>
      </article>

      <article class="card" data-search="strategy puzzle">
        <div class="game-icon">🧩</div>
        <h3>Strategy Games</h3>
        <p>Explore games focused on planning, puzzles and decision-making.</p>
        <a class="button secondary" href="#about">Learn More</a>
      </article>

      <article class="card" data-search="sports football">
        <div class="game-icon">⚽</div>
        <h3>Sports Games</h3>
        <p>Discover digital sports, teams and sports gaming features.</p>
        <a class="button secondary" href="#about">Learn More</a>
      </article>

      <article class="card" data-search="classic casual">
        <div class="game-icon">🕹️</div>
        <h3>Classic Games</h3>
        <p>Explore casual and classic gaming experiences.</p>
        <a class="button secondary" href="#about">Learn More</a>
      </article>

    </div>
  </section>

  <section class="section" id="popular">
    <div class="section-heading">
      <h2>⭐ Popular Categories</h2>
      <p>Find information based on your interests.</p>
    </div>

    <div class="cards">
      <article class="card">
        <div class="game-icon">📱</div>
        <h3>Mobile Gaming</h3>
        <p>Information about gaming experiences on mobile devices.</p>
      </article>

      <article class="card">
        <div class="game-icon">💻</div>
        <h3>PC Gaming</h3>
        <p>Explore computer gaming features and general guides.</p>
      </article>

      <article class="card">
        <div class="game-icon">📰</div>
        <h3>Gaming Updates</h3>
        <p>Read news, release information and gaming articles.</p>
      </article>
    </div>
  </section>

  <section class="section" id="about">
    <div class="info-box">
      <h2>About Orion Star Gaming</h2>
      <p>
        Orion Star Gaming is a gaming information website designed
        to help visitors explore categories, features and useful
        gaming resources through a simple mobile-friendly interface.
      </p>
      <a class="button" href="#support">Contact Support</a>
    </div>
  </section>

  <section class="section" id="support">
    <div class="info-box">
      <h2>💬 Need Help?</h2>
      <p>
        Open the chat button to try the on-page chat interface.
        This version does not yet send messages to a real support agent.
      </p>
      <button class="button" id="open-chat" type="button">
        Open Chat
      </button>
    </div>
  </section>
</main>

<footer>
  <p>© 2026 Orion Star Gaming</p>
  <p>Gaming information and category guides.</p>
</footer>

<button id="chat-button" type="button">💬 Chat Support</button>

<section id="chat-box" aria-label="Chat interface">
  <div class="chat-header">
    <span>ORION STAR SUPPORT</span>
    <button id="chat-close" type="button"
      aria-label="Close chat">×</button>
  </div>

  <div id="chat-messages" aria-live="polite">
    <div class="message">
      Welcome! This is the website's local chat preview.
    </div>
  </div>

  <form class="chat-form" id="chat-form">
    <input id="chat-input" type="text"
      maxlength="1000" placeholder="Type a message..."
      aria-label="Type a message" required>
    <button type="submit">Send</button>
  </form>
</section>

<script>
const menuButton = document.getElementById("menu-button");
const navigation = document.getElementById("navigation");

menuButton.addEventListener("click", function () {
  const isOpen = navigation.classList.toggle("open");
  menuButton.setAttribute("aria-expanded", String(isOpen));
});

navigation.querySelectorAll("a").forEach(function (link) {
  link.addEventListener("click", function () {
    navigation.classList.remove("open");
    menuButton.setAttribute("aria-expanded", "false");
  });
});

const searchInput = document.getElementById("game-search");
const gameCards = document.querySelectorAll("#game-cards .card");

searchInput.addEventListener("input", function () {
  const query = searchInput.value.trim().toLowerCase();

  gameCards.forEach(function (card) {
    const searchableText =
      (card.innerText + " " + card.dataset.search).toLowerCase();

    card.style.display = searchableText.includes(query) ? "" : "none";
  });
});

const chatBox = document.getElementById("chat-box");
const chatInput = document.getElementById("chat-input");
const chatMessages = document.getElementById("chat-messages");

function openChat() {
  chatBox.style.display = "block";
  chatInput.focus();
}

document.getElementById("chat-button").addEventListener("click", openChat);
document.getElementById("open-chat").addEventListener("click", openChat);

document.getElementById("chat-close").addEventListener("click", function () {
  chatBox.style.display = "none";
});

document.getElementById("chat-form").addEventListener("submit", function (event) {
  event.preventDefault();

  const value = chatInput.value.trim();
  if (!value) return;

  const message = document.createElement("div");
  message.className = "message";
  message.textContent = value;

  chatMessages.appendChild(message);
  chatInput.value = "";
  chatMessages.scrollTop = chatMessages.scrollHeight;
});
</script>

</body>
</html>
. 